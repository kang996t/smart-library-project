# Copy this file outside the Git repository and fill values locally.
# Never commit the populated file.

LAB=/opt/smart-library-b
MONGO_BIN_DIR=/export/servers/mongodb-8.3.11/bin
MONGOSH_BIN_DIR=/export/servers/mongosh-2.12.0/bin
MONGO_SERVICE_USER=mongolab

# Administrator credentials are consumed from the process environment.
MONGO_ADMIN_USER=replace_with_local_admin
MONGO_ADMIN_PASSWORD=replace_with_local_password

# PyMongo failover probe. Keep credentials URL-encoded when necessary.
SMART_LIBRARY_REPLICA_URI=mongodb://replace_user:replace_password@127.0.0.1:27117,127.0.0.1:27118,127.0.0.1:27119/?replicaSet=libraryRS&authSource=admin&readPreference=secondaryPreferred&retryWrites=true&w=majority
